{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": "newData.exists() && $code.matches(/^[0-9]{5}$/)",
        ".validate": "newData.hasChildren(['game', 'created', 'round', 'moves'])",
        "game": { ".validate": "newData.val() === 'cotuong' || newData.val() === 'covua'" },
        "created": { ".validate": "newData.isNumber()" },
        "round": { ".validate": "newData.isNumber()" },
        "moves": { ".validate": "newData.isString() && newData.val().length < 6000" },
        "p0": { ".validate": "newData.isBoolean()" },
        "p1": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "stats": {
      ".read": "auth != null && auth.token.email === 'virusphuoc@gmail.com' && auth.token.email_verified === true",
      "total": {
        "$key": {
          ".write": "$key.matches(/^[a-z0-9_]{1,24}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "daily": {
        "$day": {
          "$key": {
            ".write": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $key.matches(/^[a-z0-9_]{1,24}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      }
    }
  }
}
